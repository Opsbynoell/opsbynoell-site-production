{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/:all*(png|jpg|jpeg|gif|svg|webp|avif|ico|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/review-requests",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/reactivations",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/pci-generate?tier=standard",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/pci-generate?tier=realtime",
      "schedule": "0 8,14,20,2 * * *"
    }
  ]
}
